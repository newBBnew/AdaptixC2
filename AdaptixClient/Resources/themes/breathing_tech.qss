/* @theme-type: dark */

/* 
   Breathing_Tech - Structure Only
   所有颜色均由 C++ QPalette 动态注入，QSS 仅负责结构、布局和边框宽度。
*/

QWidget {
    background-color: palette(window);
    color: palette(window-text);
    font-family: "Inter", "Segoe UI", "SF Pro Display", system-ui;
    font-size: 12px; /* 字体缩小 1px 提升紧凑感 */
    outline: none;
}

/* 容器类：让 QPalette(Base) 颜色生效 */
QPlainTextEdit {
    background-color: palette(base);
    color: #E2E8F0; /* 提升对比度，满足 WCAG 4.5:1 标准 */
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 5px;
    font-family: "JetBrains Mono", "Cascadia Code", "Source Code Pro", monospace;
    font-size: 12px;
}

QTextEdit {
    background-color: palette(base);
    color: #E2E8F0;
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 5px;
}

/* 控制台专用样式 (假设控制台使用特定对象名) */
#ConsoleView, #LogView {
    background-color: #0D1117; /* 柔和控制台背景，减少突兀感 */
}

QPushButton {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 7px 14px;
    color: palette(button-text);
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: palette(window-text);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid palette(highlight);
}

/* KDDockWidgets TabBar 样式 */
QTabBar,
KDDockWidgets--QtWidgets--TabBar {
    qproperty-drawBase: 0;
    left: 5px;
    background: transparent;
    border: none;
    qproperty-iconSize: 16px 16px;
}

QTabBar::tab,
KDDockWidgets--QtWidgets--TabBar::tab {
    background-color: rgba(255, 255, 255, 0.05);
    color: palette(window-text);
    padding: 6px 22px 6px 34px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: none;
    margin-right: 1px;
    min-width: 120px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTabBar::tab:selected,
KDDockWidgets--QtWidgets--TabBar::tab:selected {
    background-color: rgba(0, 0, 0, 0.25);
    color: palette(highlight);
    border: 1px solid palette(highlight);
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
    font-weight: bold;
}

QTabBar::tab:hover,
KDDockWidgets--QtWidgets--TabBar::tab:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: palette(highlight);
}

/* 强制调整图标和文本位置 */
QTabBar::tab QToolButton,
KDDockWidgets--QtWidgets--TabBar::tab QToolButton {
    margin-left: 8px;
    margin-right: 6px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: palette(highlight);
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: palette(highlight);
}

QHeaderView::section {
    background-color: palette(button);
    color: palette(window-text);
    padding: 4px;
    border: 1px solid palette(mid);
    font-weight: bold;
}

QTableWidget::item:selected, QTableView::item:selected, QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    outline: none;
}

QMenu {
    background-color: rgba(15, 23, 42, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 28px;
    color: palette(window-text);
}

QMenu::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QComboBox {
    background-color: rgba(255, 255, 255, 0.04);
    color: palette(window-text);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 6px 34px 6px 10px;
}

QComboBox::drop-down {
    width: 24px;
    border-left: 1px solid rgba(255, 255, 255, 0.10);
}

QComboBox:focus {
    border: 1px solid palette(highlight);
}

#KDDWTitleBar {
    background-color: palette(window);
    color: palette(window-text);
    border-bottom: 1px solid palette(mid);
}

QWidget[Main="base"] {
    background-color: palette(window);
    color: palette(window-text);
}

QTabWidget::pane {
    border: 1px solid palette(mid);
    background-color: palette(window);
    top: -1px;
}

QLineEdit {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 6px 8px;
}

QLineEdit:focus {
    border: 1px solid palette(highlight);
}

QLabel[LabelStyle="console"] {
    padding: 2px;
    color: palette(text);
    background-color: transparent;
}

QLineEdit[LineEditStyle="console"] {
    background-color: rgba(0, 0, 0, 0.40);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QLineEdit[LineEditStyle="console"]:focus {
    border: 1px solid palette(highlight);
}

QTextEdit[TextEditStyle="console"],
QPlainTextEdit[TextEditStyle="console"] {
    background-color: rgba(0, 0, 0, 0.45);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 6px 8px;
}

QTextEdit[TextEditStyle="console"]:focus,
QPlainTextEdit[TextEditStyle="console"]:focus {
    border: 1px solid palette(highlight);
}

QGroupBox {
    border: 1px solid palette(mid);
    border-radius: 10px;
    margin-top: 16px;
    background-color: rgba(255, 255, 255, 0.02);
    padding: 12px;
    color: palette(highlight);
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background-color: transparent;
}

QMenuBar {
    background-color: palette(window);
    color: palette(window-text);
    border-bottom: 1px solid palette(mid);
}

QMenuBar::item {
    background: transparent;
    padding: 6px 8px;
    margin: 0px 4px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.04);
    color: palette(highlight);
}

QSplitter::handle {
    background-color: palette(mid);
}

QSplitter::handle:hover {
    background-color: palette(highlight);
}

QAbstractItemView#Completer {
    background-color: palette(base);
    border: 1px solid palette(highlight);
    border-radius: 10px;
    color: palette(text);
    padding: 4px;
    outline: none;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QAbstractItemView#Completer::item {
    padding: 4px 8px;
    border-radius: 8px;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid palette(highlight);
    image: url(:/icons/check);
}

QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 8px;
}

QRadioButton::indicator:checked {
    border: 1px solid palette(highlight);
    background-color: rgba(255, 255, 255, 0.06);
}

QToolButton {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 6px 10px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
}

QToolButton:pressed {
    border: 1px solid palette(highlight);
}

QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: rgba(255, 255, 255, 0.04);
    color: palette(text);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 6px 10px;
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus {
    border: 1px solid palette(highlight);
}

QComboBox QAbstractItemView {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 8px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QTableView,
QTreeView,
QListView,
QTableWidget,
QTreeWidget,
QListWidget {
    background-color: rgba(255, 255, 255, 0.03);
    alternate-background-color: rgba(255, 255, 255, 0.02);
    color: palette(text);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
}

QTableView::item,
QTreeView::item,
QListView::item,
QTableWidget::item,
QTreeWidget::item,
QListWidget::item {
    padding: 6px 10px;
    border: none;
}

QTableView::item:hover,
QTreeView::item:hover,
QListView::item:hover,
QTableWidget::item:hover,
QTreeWidget::item:hover,
QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: palette(window-text);
}

QHeaderView::section:horizontal {
    padding: 6px 10px;
    border-radius: 0px;
}

QProgressBar {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    color: palette(window-text);
    text-align: center;
    padding: 2px;
}

QProgressBar::chunk {
    background-color: palette(highlight);
    border-radius: 8px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.14);
}

QSlider::handle:horizontal:hover {
    border: 1px solid palette(highlight);
    background: rgba(255, 255, 255, 0.16);
}

QToolTip {
    background-color: rgba(15, 23, 42, 0.88);
    color: palette(window-text);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 6px 10px;
}
